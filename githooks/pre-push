#!/usr/bin/env bash
# githooks/pre-push - final gate before refs leave the machine:
# betterleaks (history + worktree) and the IPADP L2 privacy check
# (.specify/scripts/bash/check-privacy-leaks.sh).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v betterleaks >/dev/null 2>&1; then
    echo "ERROR: betterleaks not in PATH - secret gate cannot run." >&2
    echo "Install betterleaks, then retry the push." >&2
    exit 1
fi

if ! betterleaks git "$REPO_ROOT"; then
    echo "ERROR: betterleaks found leaks - push blocked." >&2
    exit 1
fi

if ! "$REPO_ROOT/.specify/scripts/bash/check-privacy-leaks.sh" "$REPO_ROOT"; then
    echo "ERROR: privacy check FAILED - push blocked." >&2
    exit 1
fi

echo "pre-push gate: clean"
